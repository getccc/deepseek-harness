{
  "name": "@deepseek-ai/dsh-knowledge-gateway-sqlite",
  "description": "SQLite-backed governed knowledge gateway for the DeepSeek Harness Control Plane \u2014 durable catalog, synchronization against an upstream source, per-resource authorization, and audit",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/knowledge/knowledge-gateway-sqlite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-access-control": "workspace:^",
    "@deepseek-ai/dsh-account-store": "workspace:^",
    "@deepseek-ai/dsh-audit": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-knowledge": "workspace:^",
    "@deepseek-ai/dsh-knowledge-gateway": "workspace:^",
    "@deepseek-ai/dsh-knowledge-source": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-access-control": "workspace:^",
    "@deepseek-ai/dsh-access-control-sqlite": "workspace:^",
    "@deepseek-ai/dsh-account-store": "workspace:^",
    "@deepseek-ai/dsh-account-store-sqlite": "workspace:^",
    "@deepseek-ai/dsh-audit": "workspace:^",
    "@deepseek-ai/dsh-audit-sqlite": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-knowledge": "workspace:^",
    "@deepseek-ai/dsh-knowledge-gateway": "workspace:^",
    "@deepseek-ai/dsh-knowledge-source": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  }
}
