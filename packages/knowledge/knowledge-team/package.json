{
  "name": "@deepseek-ai/dsh-knowledge-team",
  "description": "Runner-side private-knowledge provider for the DeepSeek Harness \u2014 reads the current device token per operation and reaches the company Control Plane, holding no knowledge address or credential",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/knowledge/knowledge-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-knowledge": "workspace:^",
    "@deepseek-ai/dsh-knowledge-gateway-http": "workspace:^",
    "@deepseek-ai/dsh-team-account-client": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/dsh-team-account-client": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-knowledge": "workspace:^",
    "@deepseek-ai/dsh-knowledge-gateway-http": "workspace:^"
  }
}
