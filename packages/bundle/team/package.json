{
  "name": "@deepseek-ai/dsh-team",
  "description": "The dsh Team Edition bundle: the shared local Runner surface over dsh-web-app, on a loopback port separate from dsh web",
  "version": "0.1.2-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-knowledge-controller": "workspace:^",
    "@deepseek-ai/dsh-api-office-controller": "workspace:^",
    "@deepseek-ai/dsh-client-ui-knowledge": "workspace:^",
    "@deepseek-ai/dsh-client-ui-office": "workspace:^",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview-office": "workspace:^",
    "@deepseek-ai/dsh-knowledge-team": "workspace:^",
    "@deepseek-ai/dsh-llm-http-transport-team": "workspace:^",
    "@deepseek-ai/dsh-office": "workspace:^",
    "@deepseek-ai/dsh-team-account-client": "workspace:^",
    "@deepseek-ai/dsh-team-local-login": "workspace:^",
    "@deepseek-ai/dsh-tool-knowledge": "workspace:^",
    "@deepseek-ai/dsh-tool-office": "workspace:^"
  }
}
