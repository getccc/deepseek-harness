{
  "name": "@deepseek-ai/dsh-team-local-handoff",
  "description": "The Runner local navigation endpoints that carry a member from the company site into the application on their own computer",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/team/team-local-handoff"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
