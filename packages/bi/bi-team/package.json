{
  "name": "@deepseek-ai/dsh-bi-team",
  "description": "Runner-side BI-analysis provider (ctx.bi) for the DeepSeek Harness Team profile — an outbound Control Plane request carrying the current device token, and no BI address or credential",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bi/bi-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-bi": "workspace:^",
    "@deepseek-ai/dsh-bi-gateway-http": "workspace:^",
    "@deepseek-ai/dsh-team-account-client": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/dsh-team-account-client": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-bi": "workspace:^",
    "@deepseek-ai/dsh-bi-gateway-http": "workspace:^"
  }
}
