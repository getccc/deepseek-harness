    "@deepseek-ai/dsh-util-crypto": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-bi": "workspace:^",
    "@deepseek-ai/dsh-bi-source": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-util-crypto": "workspace:^"
  }
