  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-access-control": "workspace:^",
    "@deepseek-ai/dsh-account-store": "workspace:^",
    "@deepseek-ai/dsh-bi": "workspace:^"
  }
}
