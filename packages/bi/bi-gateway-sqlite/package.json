{
  "name": "@deepseek-ai/dsh-bi-gateway-sqlite",
  "description": "SQLite-backed governed BI gateway (ctx.biGateway) for the DeepSeek Harness Control Plane — the durable project catalog, synchronization against a BI source, per-project authorization, and audit",
  "version": "0.1.6-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
